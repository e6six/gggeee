{
  "name": "solitaire-journey",
  "version": "0.1.0",
  "private": true,
  "description": "«Пасьянс-путешествие» — TriPeaks-пасьянс для Яндекс Игр (Phaser 4 + TypeScript + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:yandex": "sdk-dev-proxy --dev-mode=true",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:size": "node scripts/check-dist.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@yandex-games/sdk-dev-proxy": "^0.0.2",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
